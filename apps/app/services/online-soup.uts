export function publishOnlineSoupBottom(roomId:string,bottomIndex:number,success:(data:OnlineSoupOkResponse)=>void,fail:(error:ApiError)=>void){apiPost<OnlineSoupOkResponse>('/api/online-soup/rooms/'+encodeURIComponent(roomId)+'/publish-bottom',{bottomIndex} as UTSJSONObject,(json:string):OnlineSoupOkResponse=>JSON.parse<OnlineSoupOkResponse>(json)!,success,fail)}
export function endOnlineSoupRound(roomId:string,success:(data:OnlineSoupOkResponse)=>void,fail:(error:ApiError)=>void){apiPost<OnlineSoupOkResponse>('/api/online-soup/rooms/'+encodeURIComponent(roomId)+'/end-round',{} as UTSJSONObject,(json:string):OnlineSoupOkResponse=>JSON.parse<OnlineSoupOkResponse>(json)!,success,fail)}
