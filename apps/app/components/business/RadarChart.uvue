<template>
  <view class="chart-wrap">
    <canvas id="soup-radar-chart" class="chart"></canvas>
    <view class="legend">
      <text v-for="item in legendItems" :key="item" class="legend-item">{{ item }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { RadarStats } from '@/domain/dto/soup.uts'

const props = defineProps<{ radar: RadarStats }>()
const instance = getCurrentInstance()!.proxy!

function scoreText(score: number | null): string {
  return score == null ? '-' : score.toFixed(1)
}

function normalized(score: number | null): number {
  if (score == null) return 0
  return Math.max(0, Math.min(1, score / 10))
}

const legendItems = computed((): string[] => [
  '文笔 ' + scoreText(props.radar.writing),
  '逻辑 ' + scoreText(props.radar.logic),
  '分享 ' + scoreText(props.radar.share),
  '机制 ' + scoreText(props.radar.mechanism),
  '反转 ' + scoreText(props.radar.twist),
  '深度 ' + scoreText(props.radar.depth)
])

function drawRadar() {
  const values = [
    normalized(props.radar.writing),
    normalized(props.radar.logic),
    normalized(props.radar.share),
    normalized(props.radar.mechanism),
    normalized(props.radar.twist),
    normalized(props.radar.depth)
  ]
  uni.createCanvasContextAsync({
    id: 'soup-radar-chart',
    component: instance,
    success: (canvasContext: CanvasContext) => {
      const context = canvasContext.getContext('2d')!
      const canvas = context.canvas
      const dpr = uni.getDeviceInfo().devicePixelRatio ?? 1
      const width = canvas.offsetWidth
      const height = canvas.offsetHeight
      canvas.width = width * dpr
      canvas.height = height * dpr
      context.scale(dpr, dpr)
      const centerX = width / 2
      const centerY = height / 2
      const radius = Math.min(width, height) * 0.38

      context.clearRect(0, 0, width, height)
      context.strokeStyle = '#D7DFEA'
      context.lineWidth = 1
      for (let ring = 1; ring <= 5; ring++) {
        context.beginPath()
        for (let index = 0; index < 6; index++) {
          const angle = -Math.PI / 2 + index * Math.PI / 3
          const ringRadius = radius * ring / 5
          const x = centerX + Math.cos(angle) * ringRadius
          const y = centerY + Math.sin(angle) * ringRadius
          if (index == 0) context.moveTo(x, y)
          else context.lineTo(x, y)
        }
        context.closePath()
        context.stroke()
      }

      context.beginPath()
      for (let index = 0; index < 6; index++) {
        const angle = -Math.PI / 2 + index * Math.PI / 3
        const x = centerX + Math.cos(angle) * radius * values[index]
        const y = centerY + Math.sin(angle) * radius * values[index]
        if (index == 0) context.moveTo(x, y)
        else context.lineTo(x, y)
      }
      context.closePath()
      context.fillStyle = 'rgba(37, 99, 235, 0.22)'
      context.strokeStyle = '#2563EB'
      context.lineWidth = 2
      context.fill()
      context.stroke()
    }
  })
}

onMounted(() => {
  nextTick(() => drawRadar())
})
</script>

<style>
.chart-wrap { align-items: center; }
.chart { width: 280px; height: 230px; }
.legend { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.legend-item { width: 31%; margin: 3px; color: #667085; font-size: 11px; text-align: center; }
</style>
