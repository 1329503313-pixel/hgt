<template>
  <view class="gift-card">
    <view class="gift-visual">
      <image v-if="iconUrl.length > 0" class="gift-icon" :src="resolvedIconUrl" mode="aspectFit"></image>
      <text v-else class="gift-placeholder">礼</text>
    </view>
    <view class="gift-copy">
      <text class="gift-action">{{ senderName }} 送给 {{ receiverName }}</text>
      <view class="gift-name-row"><text class="gift-name">{{ giftName }}</text><text class="gift-quantity">×{{ quantity }}</text></view>
      <text class="gift-reward">贝壳 +{{ shellReward }} · 魅力 +{{ charmReward }}</text>
    </view>
  </view>
</template>

<script setup lang="uts">
import { absoluteApiUrl } from '@/config/runtime.uts'

const props = defineProps<{
  giftName: string,
  iconUrl: string,
  quantity: number,
  senderName: string,
  receiverName: string,
  shellReward: number,
  charmReward: number
}>()
const resolvedIconUrl = computed<string>(() => absoluteApiUrl(props.iconUrl))
</script>

