<template>
  <view class="page">
    <view class="topbar"><AppBackButton @click="goBack" /><text class="title">在线玩汤</text><view class="refresh" @click="reload"><text>↻</text></view></view>
    <scroll-view class="scroll" direction="vertical">
      <view class="intro"><text class="eyebrow">在线玩汤</text><text class="headline">多人实时推理</text><text class="subtitle">创建或加入房间，参与讨论和提问。</text></view>
      <view class="toolbar"><view><view class="toolbar-title-row"><text class="toolbar-title">在线房间</text><text class="count">{{ data.rooms.length }} 间</text></view><view class="connection"><view class="online-dot"></view><text>列表每 15 秒自动刷新</text></view></view><view class="toolbar-actions"><button class="code-button" @click="openLookup">房间号</button><button class="create-button" @click="openCreate">＋ 创建</button></view></view>
      <view v-if="data.loading && data.rooms.length==0" class="state"><text>正在读取在线房间...</text></view>
      <view v-else-if="data.errorMessage.length>0 && data.rooms.length==0" class="state"><text class="error">{{ data.errorMessage }}</text><button class="retry" @click="reload">重新加载</button></view>
      <view v-else-if="data.rooms.length==0" class="state"><text class="empty-icon">门</text><text class="state-title">暂时没有在线房间</text><text class="state-copy">创建一个房间，邀请朋友开始推理。</text><button class="create-first" @click="openCreate">创建第一个房间</button></view>
      <view v-else class="rooms"><view v-for="room in data.rooms" :key="room.id" class="room"><view class="room-head"><view class="room-copy"><text class="room-name">{{ room.name }}</text><text class="room-meta">房间号 {{ room.code }} · 主持人 {{ room.host.nickname }}</text></view><view class="tags"><text v-if="room.hasPassword" class="tag lock">密码房</text><text class="tag" :class="room.status=='playing'?'playing':''">{{ statusText(room.status) }}</text></view></view><view class="current"><text>当前海龟汤</text><text class="soup-title">{{ room.soupTitle??'尚未选择海龟汤' }}</text></view><view class="room-foot"><text class="people">👥 {{ room.participantCount }}/{{ room.participantCapacity }} 人</text><button class="join" @click="requestJoin(room)">{{ room.viewerRole==null?'加入房间':'返回房间' }}</button></view></view></view>
      <view class="safe-bottom"></view>
    </scroll-view>
    <view v-if="data.panel.length>0" class="mask" @click="closePanel"><view class="panel" @click.stop>
      <view v-if="data.panel=='create'"><text class="panel-title">创建玩汤房间</text><text class="panel-copy">你将成为房主，进入后仍可更改主持方式</text><input class="field" v-model="data.createName" maxlength="50" placeholder="例如：周五夜猫局"/><view class="role-row"><button class="role" :class="data.hostMode=='human'?'role-active':''" @click="data.hostMode='human'">真人主持</button><button class="role" :class="data.hostMode=='ai'?'role-active':''" @click="data.hostMode='ai'">AI 主持</button></view><view class="role-row"><button class="role" :class="data.createType=='public'?'role-active':''" @click="data.createType='public';data.createPassword=''">公开房</button><button class="role" :class="data.createType=='password'?'role-active':''" @click="data.createType='password'">密码房</button></view><input v-if="data.createType=='password'" class="field code-field" v-model="data.createPassword" type="number" maxlength="4" placeholder="设置 4 位密码"/><button class="primary" :disabled="data.busy" @click="createRoom">{{ data.busy?'创建中...':'创建并进入' }}</button></view>
      <view v-else-if="data.panel=='lookup'"><text class="panel-title">通过房间号加入</text><input class="field code-field" v-model="data.lookupCode" type="number" maxlength="6" placeholder="输入 6 位房间号"/><button class="primary" @click="lookupRoom">查找房间</button></view>
      <view v-else-if="data.selected!=null"><text class="panel-title">加入「{{ data.selected!.name }}」</text><text class="panel-copy">#{{ data.selected!.code }} · {{ data.selected!.participantCount }}/{{ data.selected!.participantCapacity }} 人</text><input v-if="data.selected!.hasPassword" class="field code-field" v-model="data.joinPassword" type="number" maxlength="4" placeholder="输入 4 位房间密码"/><view class="role-row"><button class="role" :disabled="data.selected!.playerCount>=data.selected!.playerCapacity" :class="data.joinRole=='player'?'role-active':''" @click="data.joinRole='player'">作为玩家</button><button class="role" :class="data.joinRole=='spectator'?'role-active':''" @click="data.joinRole='spectator'">作为旁观者</button></view><button class="primary" :disabled="data.busy" @click="joinRoom">进入房间</button></view>
      <button class="cancel" @click="closePanel">取消</button>
    </view></view>
  </view>
</template>
<script setup lang="uts">
import AppBackButton from '@/components/base/AppBackButton.uvue'
import {OnlineSoupLobbyRoom} from '@/domain/dto/online-soup.uts'
import {createOnlineSoupRoom,joinOnlineSoupRoom,loadOnlineSoupRooms,lookupOnlineSoupRoom} from '@/services/online-soup.uts'
import {restoreSession,sessionState} from '@/stores/session.uts'
type LobbyData={rooms:OnlineSoupLobbyRoom[],loading:boolean,busy:boolean,panel:string,selected:OnlineSoupLobbyRoom|null,createName:string,createType:string,createPassword:string,hostMode:string,lookupCode:string,joinPassword:string,joinRole:string,timerId:number,errorMessage:string}
const data=reactive({rooms:[],loading:false,busy:false,panel:'',selected:null,createName:'',createType:'public',createPassword:'',hostMode:'human',lookupCode:'',joinPassword:'',joinRole:'player',timerId:0,errorMessage:''} as LobbyData)
function goBack(){uni.navigateBack()}
function statusText(status:string):string{return status=='playing'?'推理中':status=='ended'?'本轮已结束':'准备中'}
function ensureLogin():boolean{if(sessionState.user!=null)return true;uni.navigateTo({url:'/pages/auth/auth'});return false}
function enterRoom(id:string){uni.navigateTo({url:'/pages/online-soup-room/online-soup-room?id='+encodeURIComponent(id)})}
function closePanel(){data.panel='';data.selected=null;data.busy=false}
function openCreate(){if(ensureLogin())data.panel='create'}
function openLookup(){if(ensureLogin())data.panel='lookup'}
function requestJoin(room:OnlineSoupLobbyRoom){if(!ensureLogin())return;if(room.viewerRole!=null){enterRoom(room.id);return}data.selected=room;data.joinPassword='';data.joinRole=room.playerCount>=room.playerCapacity?'spectator':'player';data.panel='join'}
function reload(){if(data.loading)return;data.loading=true;data.errorMessage='';loadOnlineSoupRooms((response)=>{data.rooms=response.rooms;data.loading=false},(error)=>{data.loading=false;data.errorMessage=error.message})}
function createRoom(){const name=data.createName.trim();if(name.length==0){uni.showToast({title:'请填写房间名称',icon:'none'});return}if(data.createType=='password'&&data.createPassword.length!=4){uni.showToast({title:'房间密码必须为 4 位',icon:'none'});return}data.busy=true;createOnlineSoupRoom(name,data.createType,data.createPassword,data.hostMode,(response)=>{data.busy=false;closePanel();enterRoom(response.roomId)},(error)=>{data.busy=false;uni.showToast({title:error.message,icon:'none'})})}
function lookupRoom(){const code=data.lookupCode.trim();if(code.length!=6){uni.showToast({title:'请输入 6 位房间号',icon:'none'});return}lookupOnlineSoupRoom(code,(response)=>{data.panel='';requestJoin(response.room)},(error)=>uni.showToast({title:error.message,icon:'none'}))}
function joinRoom(){if(data.selected==null)return;if(data.selected!.hasPassword&&data.joinPassword.length!=4){uni.showToast({title:'请输入 4 位房间密码',icon:'none'});return}data.busy=true;joinOnlineSoupRoom(data.selected!.id,data.joinPassword,data.joinRole,(response)=>{data.busy=false;const id=response.roomId;closePanel();enterRoom(id)},(error)=>{data.busy=false;uni.showToast({title:error.message,icon:'none'})})}
function stopTimer(){if(data.timerId!=0){clearInterval(data.timerId);data.timerId=0}}
function startTimer(){stopTimer();data.timerId=setInterval(()=>{reload()},15000)}
onLoad(()=>{if(!sessionState.restored)restoreSession();reload()})
onShow(()=>{reload();startTimer()})
onHide(()=>stopTimer());onUnload(()=>stopTimer())
</script>
<style>
.page{flex:1;background-color:#F4F7FB}.topbar{height:96px;padding:48px 14px 8px;flex-direction:row;align-items:center;justify-content:space-between;background-color:#FFF}.back,.refresh{width:40px;height:40px;align-items:center;justify-content:center;color:#344054;font-size:30px}.title{color:#121826;font-size:17px;font-weight:900}.scroll{flex:1}.intro{margin:12px 16px;padding:18px;border-radius:20px;background-color:#0B2147}.eyebrow{color:#93C5FD;font-size:10px;font-weight:900}.headline{margin-top:5px;color:#FFF;font-size:22px;font-weight:900}.subtitle{margin-top:7px;color:#BFDBFE;font-size:12px}.toolbar{margin:0 16px 10px;padding:13px 2px;flex-direction:row;align-items:center;justify-content:space-between}.toolbar-title-row,.connection,.toolbar-actions,.room-head,.tags,.room-foot,.role-row{flex-direction:row;align-items:center}.toolbar-title{color:#121826;font-size:18px;font-weight:900}.count{margin-left:7px;padding:3px 7px;border-radius:9px;background-color:#DBEAFE;color:#2563EB;font-size:9px}.connection{margin-top:5px;color:#667085;font-size:9px}.online-dot{width:7px;height:7px;margin-right:5px;border-radius:4px;background-color:#12B76A}.code-button,.create-button{height:36px;margin-left:6px;padding:0 10px;border-radius:10px;font-size:11px;font-weight:800;line-height:36px}.code-button{border-width:1px;border-color:#BFDBFE;background-color:#FFF;color:#2563EB}.create-button{background-color:#2563EB;color:#FFF}.rooms{padding:0 16px}.room{margin-bottom:10px;padding:14px;border-width:1px;border-color:#E5EAF2;border-radius:18px;background-color:#FFF}.room-head{align-items:flex-start;justify-content:space-between}.room-copy{flex:1;min-width:0}.room-name{color:#121826;font-size:15px;font-weight:900;lines:1}.room-meta{margin-top:5px;color:#667085;font-size:9px}.tag{margin-left:5px;padding:4px 6px;border-radius:8px;background-color:#EFF6FF;color:#2563EB;font-size:8px;font-weight:800}.lock{background-color:#FFFAEB;color:#B54708}.playing{background-color:#ECFDF3;color:#027A48}.current{margin-top:13px;padding:10px;border-radius:11px;background-color:#F8FAFC;color:#667085;font-size:9px}.soup-title{margin-top:4px;color:#344054;font-size:11px;font-weight:800;lines:1}.room-foot{margin-top:12px;justify-content:space-between}.people{color:#667085;font-size:10px}.join{height:36px;padding:0 13px;border-radius:10px;background-color:#2563EB;color:#FFF;font-size:11px;font-weight:800;line-height:36px}.state{margin:16px;padding:38px 18px;align-items:center;border-radius:18px;background-color:#FFF;color:#667085}.empty-icon{width:50px;height:50px;padding-top:13px;border-radius:25px;background-color:#EFF6FF;color:#2563EB;text-align:center}.state-title{margin-top:12px;color:#121826;font-size:16px;font-weight:900}.state-copy{margin-top:6px;font-size:11px}.create-first,.retry,.primary,.cancel{width:100%;height:42px;padding:0;border-radius:11px;font-size:11px;font-weight:800;line-height:42px}.create-first,.retry{margin-top:16px;background-color:#2563EB;color:#FFF}.error{color:#B42318}.mask{position:fixed;left:0;right:0;top:0;bottom:0;padding:24px;align-items:center;justify-content:center;background-color:rgba(15,23,42,.55)}.panel{width:100%;padding:20px;border-radius:22px;background-color:#FFF}.panel-title{color:#121826;font-size:19px;font-weight:900}.panel-copy{margin-top:6px;color:#667085;font-size:11px}.field{height:46px;margin-top:16px;padding:0 13px;border-width:1px;border-color:#D0D5DD;border-radius:12px;background-color:#FFF;color:#121826}.code-field{text-align:center}.role-row{margin-top:12px}.role{flex:1;height:42px;margin:0 3px;padding:0;border-width:1px;border-color:#D0D5DD;border-radius:11px;background-color:#FFF;color:#344054;font-size:11px;font-weight:800;line-height:42px}.role-active{border-color:#2563EB;background-color:#EFF6FF;color:#2563EB}.primary{margin-top:14px;background-color:#2563EB;color:#FFF}.cancel{margin-top:8px;background-color:#F2F4F7;color:#344054}.safe-bottom{height:30px}
</style>
