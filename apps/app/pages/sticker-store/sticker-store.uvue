<template>
  <view class="page">
    <view class="topbar"><AppBackButton @click="goBack" /><text class="title">表情包</text><view class="back"></view></view>
    <view v-if="data.loading" class="state"><text>正在加载表情包...</text></view>
    <view v-else-if="data.errorMessage.length > 0" class="state"><text class="error">{{ data.errorMessage }}</text><button class="retry" @click="reload">重新加载</button></view>
    <scroll-view v-else class="scroll" direction="vertical">
      <view class="wallet"><view><text class="wallet-label">当前贝壳余额</text><view class="balance-row"><image class="shell" src="/static/tasks/shell.png" mode="aspectFit"></image><text class="balance">{{ data.store == null ? 0 : data.store!.balance }}</text></view></view><image class="wallet-icon" src="/static/messages/smile.png" mode="aspectFit"></image></view>
      <scroll-view v-if="series.length > 0" class="series-tabs" direction="horizontal" :show-scrollbar="false"><view class="series-row"><view v-for="item in series" :key="item.id" class="series-tab" :class="item.id == data.seriesId ? 'series-active' : ''" hover-class="series-pressed" @click="selectSeries(item.id)"><text class="series-label" :class="item.id == data.seriesId ? 'series-label-active' : ''">{{ item.name }}</text></view></view></scroll-view>
      <view v-if="activeSeries == null" class="empty"><text class="empty-title">暂无在售表情</text><text class="empty-copy">管理员上架表情后会展示在这里。</text></view>
      <view v-else class="content"><text class="section-title">{{ activeSeries!.name }}</text><text v-if="activeSeries!.description.length > 0" class="section-description">{{ activeSeries!.description }}</text><view class="grid"><view v-for="sticker in activeSeries!.stickers" :key="sticker.id" class="sticker-card"><view class="image-wrap"><image class="sticker-image" :src="assetUrl(sticker.animatedUrl.length > 0 ? sticker.animatedUrl : sticker.staticUrl)" mode="aspectFit"></image></view><text class="sticker-name">{{ sticker.name }}</text><text class="sticker-description">{{ sticker.description.length > 0 ? sticker.description : '来自“' + activeSeries!.name + '”系列' }}</text><button class="buy-button" :class="sticker.owned ? 'owned-button' : ''" :disabled="sticker.owned || data.purchasingId.length > 0" hover-class="buy-pressed" @click="confirmPurchase(sticker)"><text class="buy-label" :class="sticker.owned ? 'owned-label' : ''">{{ sticker.owned ? '已拥有' : sticker.price.toString() + ' 贝壳' }}</text></button></view></view></view>
      <view class="safe-bottom"></view>
    </scroll-view>
  </view>
</template>
<script setup lang="uts">
import AppBackButton from '@/components/base/AppBackButton.uvue'
import { absoluteApiUrl } from '@/config/runtime.uts'
import { StickerStoreResponse, StoreSticker, StoreStickerSeries } from '@/domain/dto/digital-asset.uts'
import { loadStickerStore, purchaseSticker } from '@/services/digital-assets.uts'
type PageData = { store: StickerStoreResponse | null, seriesId: string, loading: boolean, purchasingId: string, errorMessage: string }
const data = reactive({ store: null, seriesId: '', loading: false, purchasingId: '', errorMessage: '' } as PageData)
const series = computed((): StoreStickerSeries[] => data.store == null ? [] as StoreStickerSeries[] : data.store!.series)
const activeSeries = computed((): StoreStickerSeries | null => { const item = series.value.find((value: StoreStickerSeries): boolean => value.id == data.seriesId); return item == null ? (series.value.length > 0 ? series.value[0] : null) : item! })
function goBack() { uni.navigateBack() }
function assetUrl(value: string): string { return absoluteApiUrl(value) }
function selectSeries(id: string) { data.seriesId = id }
function reload() { if (data.loading) return; data.loading = true; data.errorMessage = ''; loadStickerStore((response) => { data.store = response; if (!response.series.some((item: StoreStickerSeries): boolean => item.id == data.seriesId)) data.seriesId = response.series.length > 0 ? response.series[0].id : ''; data.loading = false }, (error) => { data.loading = false; data.errorMessage = error.message }) }
function confirmPurchase(sticker: StoreSticker) { if (sticker.owned || data.purchasingId.length > 0 || data.store == null) return; uni.showModal({ title: '购买“' + sticker.name + '”', content: '将支付 ' + sticker.price.toString() + ' 贝壳，购买后立即加入聊天表情键盘。', confirmText: sticker.price > data.store!.balance ? '贝壳不足' : '确认购买', success: (result) => { if (!result.confirm || data.store == null || sticker.price > data.store!.balance) return; buy(sticker) } }) }
function buy(sticker: StoreSticker) { data.purchasingId = sticker.id; data.errorMessage = ''; const requestId = 'sticker-' + Date.now().toString() + '-' + Math.floor(Math.random() * 1000000).toString(); purchaseSticker(sticker.id, requestId, (response) => { if (data.store != null) { data.store!.balance = response.balance; sticker.owned = true }; data.purchasingId = ''; uni.showToast({ title: '已加入聊天键盘', icon: 'success' }) }, (error) => { data.purchasingId = ''; data.errorMessage = error.message }) }
onLoad(() => reload())
</script>
<style>
.page{flex:1;background-color:#F4F7FB}.topbar{height:96px;padding:48px 14px 8px;flex-direction:row;align-items:center;justify-content:space-between;background-color:#FFF}.back{width:40px}.title{color:#121826;font-size:17px;font-weight:800}.scroll{flex:1}.state{flex:1;align-items:center;justify-content:center;padding:24px}.error{color:#B42318;font-size:13px;text-align:center}.retry{margin-top:14px;font-size:13px}.wallet{margin:12px 16px;padding:20px;border-radius:24px;flex-direction:row;align-items:center;justify-content:space-between;background-color:#0891B2;background-image:linear-gradient(135deg,#06B6D4,#2563EB)}.wallet-label{color:#CFFAFE;font-size:11px;font-weight:700}.balance-row{margin-top:6px;flex-direction:row;align-items:center}.shell{width:25px;height:25px;margin-right:8px}.balance{color:#FFF;font-size:30px;font-weight:900}.wallet-icon{width:50px;height:50px;opacity:.65}.series-tabs{height:54px;margin:0 16px}.series-row{height:54px;flex-direction:row;align-items:center}.series-tab{height:42px;margin-right:8px;padding:0 18px;align-items:center;justify-content:center;border-width:1px;border-color:#E5EAF2;border-radius:21px;background-color:#FFF}.series-active{border-color:#2563EB;background-color:#2563EB}.series-pressed{opacity:.75}.series-label{color:#667085;font-size:13px;font-weight:800}.series-label-active{color:#FFF}.content{padding:6px 16px 16px}.section-title{color:#121826;font-size:18px;font-weight:900}.section-description{margin-top:5px;color:#667085;font-size:12px;line-height:19px}.grid{margin-top:12px;flex-direction:row;flex-wrap:wrap;justify-content:space-between}.sticker-card{width:48.5%;margin-bottom:12px;padding:10px;border-width:1px;border-color:#E5EAF2;border-radius:18px;background-color:#FFF}.image-wrap{width:100%;height:142px;align-items:center;justify-content:center;border-radius:14px;background-color:#EFF6FF}.sticker-image{width:128px;height:128px}.sticker-name{margin-top:10px;color:#121826;font-size:14px;font-weight:900}.sticker-description{height:38px;margin-top:4px;color:#667085;font-size:10px;line-height:16px}.buy-button{height:44px;margin-top:8px;align-items:center;justify-content:center;border-radius:12px;background-color:#2563EB}.owned-button{background-color:#ECFDF3}.buy-label{color:#FFF;font-size:13px;font-weight:900}.owned-label{color:#047857}.buy-pressed{opacity:.78}.empty{margin:24px 16px;padding:36px;align-items:center;border-radius:20px;background-color:#FFF}.empty-title{color:#121826;font-size:16px;font-weight:900}.empty-copy{margin-top:8px;color:#667085;font-size:12px}.safe-bottom{height:calc(24px + env(safe-area-inset-bottom))}
</style>
