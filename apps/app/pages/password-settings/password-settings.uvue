<template>
  <view class="page">
    <view class="intro-card">
      <text class="eyebrow">ACCOUNT SECURITY</text>
      <text class="headline">重置密码</text>
      <text class="intro">设置一个新的登录密码，保存后当前登录状态会继续保留。</text>
    </view>
    <view class="card">
      <text class="label">新密码</text>
      <input class="field" v-model="data.password" type="password" maxlength="72" placeholder="至少 6 位" />
      <text class="hint">密码至少 6 位</text>
      <text class="label confirm-label">再次输入新密码</text>
      <input class="field" v-model="data.confirmPassword" type="password" maxlength="72" placeholder="请再次输入新密码" />
      <text v-if="data.errorMessage.length > 0" class="error-text">{{ data.errorMessage }}</text>
      <button class="submit-button" :disabled="data.saving" @click="submit">{{ data.saving ? '提交中...' : '确认重置' }}</button>
    </view>
  </view>
</template>

<script setup lang="uts">
import { updatePassword } from '@/services/account.uts'
import { sessionState } from '@/stores/session.uts'
import { accountPasswordError } from '@/services/account-rules.uts'

type PasswordData = {
  password: string,
  confirmPassword: string,
  saving: boolean,
  errorMessage: string
}
const data = reactive({
  password: '',
  confirmPassword: '',
  saving: false,
  errorMessage: ''
} as PasswordData)
function submit() {
  if (data.saving) return
  if (sessionState.user == null) {
    uni.redirectTo({ url: '/pages/auth/auth' })
    return
  }
  const validationError = accountPasswordError(data.password)
  if (validationError.length > 0) {
    data.errorMessage = validationError
    return
  }
  if (data.password != data.confirmPassword) {
    data.errorMessage = '两次输入的新密码不一致'
    return
  }
  data.saving = true
  data.errorMessage = ''
  updatePassword(data.password, (_) => {
    data.saving = false
    data.password = ''
    data.confirmPassword = ''
    uni.showToast({ title: '密码已重置', icon: 'success' })
    setTimeout(() => { uni.navigateBack() }, 500)
  }, (error) => {
    data.saving = false
    data.errorMessage = error.message
    if (error.statusCode == 401) uni.redirectTo({ url: '/pages/auth/auth' })
  })
}
</script>

<style>
.page { flex: 1; background-color: #F4F7FB; }
.intro-card { margin: 12px 12px 0 12px; padding: 18px; border-radius: 18px; background-color: #2563EB; }
.eyebrow { color: #BFDBFE; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
.headline { margin-top: 6px; color: #FFFFFF; font-size: 23px; font-weight: 800; }
.intro { margin-top: 7px; color: #DBEAFE; font-size: 12px; line-height: 19px; }
.card { margin: 10px 12px; padding: 16px; border-width: 1px; border-color: #E5EAF2; border-radius: 18px; background-color: #FFFFFF; }
.label { margin-bottom: 8px; color: #344054; font-size: 12px; font-weight: 700; }
.confirm-label { margin-top: 16px; }
.field { width: 100%; height: 46px; padding: 0 12px; border-width: 1px; border-color: #DCE3EE; border-radius: 12px; background-color: #FFFFFF; color: #121826; font-size: 14px; }
.hint { margin-top: 7px; color: #667085; font-size: 10px; }
.error-text { margin-top: 12px; color: #D92D20; font-size: 12px; font-weight: 700; }
.submit-button { margin-top: 18px; min-height: 46px; border-radius: 13px; background-color: #2563EB; color: #FFFFFF; font-size: 14px; font-weight: 700; }
</style>
