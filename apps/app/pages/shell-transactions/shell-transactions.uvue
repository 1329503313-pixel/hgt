<template><view class="page"><view class="topbar"><AppBackButton @click="goBack" /><text class="title">贝壳明细</text><view class="back"></view></view><view class="summary"><view><text class="label">当前余额</text><view class="balance-row"><image src="/static/tasks/shell.png" class="shell-icon" mode="aspectFit"></image><text class="balance">{{ data.balance }}</text></view></view><text class="total">共 {{ data.total }} 条记录</text></view><view v-if="data.loading && data.items.length == 0" class="state"><text>正在加载明细...</text></view><view v-else-if="data.errorMessage.length > 0 && data.items.length == 0" class="state"><text class="error">{{ data.errorMessage }}</text><button class="retry" @click="reload">重新加载</button></view><list-view v-else class="list" @scrolltolower="loadMore"><list-item v-for="item in data.items" :key="item.id" class="item"><view class="amount-icon" :class="item.amount >= 0 ? 'income-icon' : 'expense-icon'"><text>{{ item.amount >= 0 ? '+' : '−' }}</text></view><view class="copy"><text class="remark">{{ item.remark == null || item.remark!.length == 0 ? item.typeLabel : item.remark }}</text><text class="time">{{ timeText(item.createdAt) }}</text></view><view class="tail"><text class="amount" :class="item.amount >= 0 ? 'income' : 'expense'">{{ item.amount >= 0 ? '+' : '' }}{{ item.amount }}</text><text class="after">余额 {{ item.balanceAfter }}</text></view></list-item><list-item v-if="data.items.length == 0" class="empty"><text>暂无贝壳变动记录</text></list-item><list-item v-if="data.loading && data.items.length > 0" class="loading-more"><text>加载中...</text></list-item><list-item v-else-if="!data.hasMore && data.items.length > 0" class="loading-more"><text>已经到底了</text></list-item></list-view></view></template>
<script setup lang="uts">
import AppBackButton from '@/components/base/AppBackButton.uvue'
import { ShellTaskCenter, ShellTransaction } from '@/domain/dto/shell.uts'
import { loadShellTaskCenter, loadShellTransactions } from '@/services/shells.uts'
type TransactionData = { items: ShellTransaction[], balance: number, total: number, hasMore: boolean, loading: boolean, errorMessage: string }
const data = reactive({ items: [] as ShellTransaction[], balance: 0, total: 0, hasMore: true, loading: false, errorMessage: '' } as TransactionData)
function goBack() { uni.navigateBack() }
function timeText(value: string): string { const date = new Date(value); return date.getFullYear().toString() + '-' + (date.getMonth() + 1).toString().padStart(2, '0') + '-' + date.getDate().toString().padStart(2, '0') + ' ' + date.getHours().toString().padStart(2, '0') + ':' + date.getMinutes().toString().padStart(2, '0') }
function loadMore() { if (data.loading || !data.hasMore) return; data.loading = true; data.errorMessage = ''; loadShellTransactions(data.items.length, (response) => { data.items.push(...response.transactions); data.total = response.total; data.hasMore = response.hasMore; data.loading = false }, (error) => { data.loading = false; data.errorMessage = error.message }) }
function reload() { data.items = []; data.hasMore = true; loadMore(); loadShellTaskCenter((response: ShellTaskCenter) => { data.balance = response.balance }, (_) => {}) }
onLoad(() => { reload() })
</script>
<style>
.page { flex: 1; background-color: #F4F7FB; }.topbar { height: 96px; padding: 48px 14px 8px; flex-direction: row; align-items: center; justify-content: space-between; background-color: #FFFFFF; }.back { width: 40px; height: 40px; align-items: center; justify-content: center; color: #344054; font-size: 32px; }.title { color: #121826; font-size: 17px; font-weight: 800; }.summary { margin: 14px 16px; padding: 17px; flex-direction: row; align-items: center; justify-content: space-between; border-radius: 18px; background-color: #2563EB; }.label { color: #BFDBFE; font-size: 10px; }.balance-row { margin-top: 5px; flex-direction: row; align-items: center; }.shell-icon { width: 23px; height: 23px; margin-right: 6px; }.balance { color: #FFFFFF; font-size: 25px; font-weight: 800; }.total { color: #DBEAFE; font-size: 11px; }.list { flex: 1; margin: 0 16px; border-radius: 18px; background-color: #FFFFFF; }.item { min-height: 74px; padding: 13px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #F0F2F5; }.amount-icon { width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 20px; font-size: 20px; font-weight: 800; }.income-icon { background-color: #ECFDF3; color: #039855; }.expense-icon { background-color: #FEF3F2; color: #D92D20; }.copy { flex: 1; min-width: 0; margin-left: 10px; }.remark { color: #121826; font-size: 13px; font-weight: 800; lines: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.time { margin-top: 5px; color: #98A2B3; font-size: 9px; }.tail { margin-left: 8px; align-items: flex-end; }.amount { font-size: 16px; font-weight: 800; }.income { color: #039855; }.expense { color: #D92D20; }.after { margin-top: 5px; color: #98A2B3; font-size: 9px; }.state { margin: 16px; padding: 28px; align-items: center; border-radius: 18px; background-color: #FFFFFF; color: #667085; }.error { color: #B42318; }.retry { width: 100%; margin-top: 14px; background-color: #2563EB; color: #FFFFFF; }.empty, .loading-more { padding: 36px 16px; align-items: center; color: #98A2B3; font-size: 11px; }
</style>
