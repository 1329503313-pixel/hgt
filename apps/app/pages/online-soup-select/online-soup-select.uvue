<template>
  <view class="page"><view class="topbar"><AppBackButton @click="goBack" /><view class="top-copy"><text class="title">选择海龟汤</text><text class="subtitle">选择后返回房间，由主持人开始游戏</text></view></view>
    <view class="toolbar"><view class="tabs"><view class="tab" :class="data.source=='library'?'active':''" @click="changeSource('library')"><text class="tab-text" :class="data.source=='library'?'tab-text-active':''">汤库</text></view><view class="tab" :class="data.source=='mine'?'active':''" @click="changeSource('mine')"><text class="tab-text" :class="data.source=='mine'?'tab-text-active':''">我的发布</text></view></view><view class="search"><input class="input" v-model="data.keyword" confirm-type="search" placeholder="搜索汤名或作者" @confirm="reload"/><text class="search-action" @click="reload">搜索</text></view></view>
    <view v-if="data.loading&&data.soups.length==0" class="state"><text>正在读取可选海龟汤...</text></view><view v-else-if="data.errorMessage.length>0&&data.soups.length==0" class="state"><text class="error">{{ data.errorMessage }}</text><button class="retry" @click="reload">重新加载</button></view>
    <list-view v-else class="list" @scrolltolower="loadMore"><list-item v-for="soup in data.soups" :key="soup.id" class="soup" @click="choose(soup)"><image v-if="cover(soup).length>0" class="cover" :src="cover(soup)" mode="aspectFill"></image><view v-else class="cover placeholder"><text>汤</text></view><view class="copy"><text class="soup-title">{{ soup.title }}</text><text class="author">{{ soup.author.length>0?soup.author:'佚名' }}</text><text class="type">{{ soup.type }}</text><text class="summary">{{ soup.summary.length>0?soup.summary:'暂无摘要' }}</text></view><view class="choose" :class="data.selectingId.length>0?'choose-disabled':''" hover-class="choose-pressed" @click.stop="choose(soup)"><text class="choose-text">{{ data.selectingId==soup.id?'选择中':'选择' }}</text></view></list-item><list-item v-if="data.soups.length==0" class="empty"><text>暂无可选择的海龟汤</text></list-item><list-item v-if="data.soups.length>0" class="footer"><text>{{ data.loading?'加载中...':data.hasMore?'继续上滑加载':'已展示全部' }}</text></list-item></list-view>
  </view>
</template>
<script setup lang="uts">
import AppBackButton from '@/components/base/AppBackButton.uvue'
import {absoluteApiUrl} from '@/config/runtime.uts'
import {OnlineSoupChoice} from '@/domain/dto/online-soup.uts'
import {loadEligibleOnlineSoups,selectOnlineSoup} from '@/services/online-soup.uts'
type SelectData={roomId:string,source:string,keyword:string,soups:OnlineSoupChoice[],page:number,hasMore:boolean,loading:boolean,selectingId:string,errorMessage:string}
const data=reactive({roomId:'',source:'library',keyword:'',soups:[],page:0,hasMore:true,loading:false,selectingId:'',errorMessage:''} as SelectData)
function goBack(){uni.navigateBack()}
function cover(soup:OnlineSoupChoice):string{return absoluteApiUrl(soup.coverImage)}
function fetchPage(append:boolean){if(data.loading||(append&&!data.hasMore))return;data.loading=true;data.errorMessage='';const page=append?data.page:0;loadEligibleOnlineSoups(data.source,data.keyword.trim(),page,(response)=>{data.soups=append?data.soups.concat(response.soups):response.soups;data.page=response.nextPage??page;data.hasMore=response.hasMore;data.loading=false},(error)=>{data.loading=false;data.errorMessage=error.message})}
function reload(){fetchPage(false)}
function loadMore(){fetchPage(true)}
function changeSource(source:string){if(data.source==source)return;data.source=source;data.soups=[];data.hasMore=true;reload()}
function choose(soup:OnlineSoupChoice){if(data.selectingId.length>0)return;uni.showModal({title:'选择海龟汤',content:'确认将《'+soup.title+'》设为本轮海龟汤？',cancelText:'取消',confirmText:'选择',success:(result)=>{if(!result.confirm)return;data.selectingId=soup.id;selectOnlineSoup(data.roomId,soup.id,(_)=>{uni.navigateBack()},(error)=>{data.selectingId='';uni.showToast({title:error.message,icon:'none'})})}})}
onLoad((options)=>{data.roomId=options['roomId']??'';reload()})
</script>
<style>
.page{flex:1;background-color:#F4F7FB}.topbar{height:96px;padding:48px 14px 8px;flex-direction:row;align-items:center;background-color:#FFF}.back{width:40px;height:40px;align-items:center;justify-content:center;color:#344054;font-size:32px}.top-copy{flex:1}.title{color:#121826;font-size:16px;font-weight:900}.subtitle{margin-top:3px;color:#667085;font-size:9px}.toolbar{padding:12px 16px;background-color:#F4F7FB}.tabs{padding:4px;flex-direction:row;border-radius:13px;background-color:#E9EDF3}.tab{flex:1;height:36px;align-items:center;justify-content:center;border-radius:10px}.tab-text{color:#667085;font-size:11px;font-weight:800;line-height:16px}.tab-text-active{color:#2563EB}.active{background-color:#FFF}.search{height:43px;margin-top:9px;padding-left:11px;flex-direction:row;align-items:center;border-width:1px;border-color:#E5EAF2;border-radius:12px;background-color:#FFF}.input{flex:1;height:41px;font-size:12px}.search-action{padding:12px;color:#2563EB;font-size:11px;font-weight:800}.list{flex:1;padding:0 16px}.soup{min-height:126px;margin-bottom:9px;padding:10px;flex-direction:row;align-items:center;border-width:1px;border-color:#E5EAF2;border-radius:15px;background-color:#FFF}.cover{width:82px;height:106px;border-radius:10px}.placeholder{align-items:center;justify-content:center;background-color:#DBEAFE;color:#2563EB;font-size:24px;font-weight:900}.copy{flex:1;min-width:0;margin-left:11px}.soup-title{color:#121826;font-size:14px;font-weight:900;lines:1}.author{margin-top:4px;color:#667085;font-size:9px}.type{align-self:flex-start;margin-top:6px;padding:3px 6px;border-radius:7px;background-color:#EFF6FF;color:#2563EB;font-size:8px}.summary{margin-top:6px;color:#667085;font-size:9px;lines:2}.choose{width:58px;height:36px;margin-left:7px;align-items:center;justify-content:center;border-radius:10px;background-color:#2563EB}.choose-text{color:#FFF;font-size:11px;font-weight:800}.choose-disabled{opacity:.55}.choose-pressed{opacity:.78;transform:scale(.97)}.state,.empty,.footer{padding:35px;align-items:center;color:#667085}.error{color:#B42318}.retry{width:100%;height:42px;margin-top:12px;padding:0;border-radius:11px;background-color:#2563EB;color:#FFF;font-size:11px;font-weight:800;line-height:42px}
</style>
