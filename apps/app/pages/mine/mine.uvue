<template>
  <MineDashboard />
</template>

<script setup lang="uts">
import MineDashboard from '@/components/business/MineDashboard.uvue'
import { absoluteApiUrl } from '@/config/runtime.uts'
import { ContentCounts } from '@/domain/dto/user.uts'
import { loadContentCounts } from '@/services/account.uts'
import { logoutSession, restoreSession, sessionState } from '@/stores/session.uts'

type MineData = {
  counts: ContentCounts | null,
  loadingCounts: boolean,
  loggingOut: boolean,
  errorMessage: string
}
const data = reactive({
  counts: null,
  loadingCounts: false,
  loggingOut: false,
  errorMessage: ''
} as MineData)
const avatarUrl = computed((): string => sessionState.user == null ? '' : absoluteApiUrl(sessionState.user!.avatar))
const avatarText = computed((): string => {
  if (sessionState.user == null || sessionState.user!.nickname.length == 0) return '汤'
  return sessionState.user!.nickname.substring(0, 1)
})

function openAuth() { uni.navigateTo({ url: '/pages/auth/auth' }) }
function openMessages() { uni.switchTab({ url: '/pages/messages/messages' }) }
function openSettings() { uni.navigateTo({ url: '/pages/account-settings/account-settings' }) }
function openTasks() { uni.navigateTo({ url: '/pages/shell-tasks/shell-tasks' }) }
function openRankings() { uni.navigateTo({ url: '/pages/rankings/rankings' }) }
function openAchievements() { uni.navigateTo({ url: '/pages/achievements/achievements' }) }
function openAssetStore() { uni.navigateTo({ url: '/pages/asset-store/asset-store' }) }
function openMyProfile() { if (sessionState.user != null) uni.navigateTo({ url: '/pages/user-profile/user-profile?id=' + encodeURIComponent(sessionState.user!.id) }) }
function openInteractions(mode: string) { uni.navigateTo({ url: '/pages/my-interactions/my-interactions?mode=' + mode }) }
function loadCounts() {
  if (sessionState.user == null || data.loadingCounts) return
  data.loadingCounts = true
  data.errorMessage = ''
  loadContentCounts((response) => {
    data.counts = response
    data.loadingCounts = false
  }, (error) => {
    data.loadingCounts = false
    data.errorMessage = error.message
  })
}
function confirmLogout() {
  if (data.loggingOut) return
  uni.showModal({
    title: '退出登录',
    content: '确认退出当前账号？',
    cancelText: '取消',
    confirmText: '退出',
    success: (result) => {
      if (!result.confirm) return
      data.loggingOut = true
      logoutSession(() => {
        data.loggingOut = false
        data.counts = null
        uni.showToast({ title: '已退出登录', icon: 'none' })
      }, (error) => {
        data.loggingOut = false
        data.errorMessage = error.message
      })
    }
  })
}

onLoad(() => {
  if (!sessionState.restored) restoreSession()
})
onShow(() => {
  // 数据由 MineDashboard 在页面显示时统一刷新。
})
watch((): string => sessionState.user == null ? '' : sessionState.user!.id, (userId: string) => {
  if (userId.length == 0) data.counts = null
})
</script>

